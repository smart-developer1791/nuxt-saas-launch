{
  "name": "nuxt-saas-launch",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "description": "Relay: a Nuxt SaaS landing template with interactive workflows and transparent team pricing.",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "serve .output/public --no-clipboard",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "preview:images": "node scripts/capture-previews.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@lucide/vue": "1.52.0",
    "@tailwindcss/vite": "^4.3.3",
    "nuxt": "4.5.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.1",
    "prettier": "^3.9.9",
    "serve": "^14.2.6",
    "typescript": "6.0.2",
    "vue-tsc": "^3.3.12"
  },
  "overrides": {
    "simple-git": "4.0.2",
    "compression": "1.8.2"
  }
}
